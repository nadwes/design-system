        <a href="#comp-headers"><span class="nav-num">03</span> Headers</a>
        <a href="#comp-steppers"><span class="nav-num">04</span> Steppers</a>
        <a href="#comp-cards"><span class="nav-num">05</span> Cards</a>
        <a href="#comp-nav"><span class="nav-num">06</span> Navigation Patterns</a>
      </nav>
    </aside>
    <!-- Composite Components main content -->
    <div class="panel-main">
      <div class="panel-content">

        <div style="margin-bottom:48px">
          <h2 class="section-title">Composite Components</h2>
          <p style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text-subtle);line-height:22px;max-width:640px">
            Assembled UI blocks built from Core Components and Foundations tokens. These are larger, multi-part patterns used directly in product screens.
          </p>
        </div>

        <!-- Pricing Cards -->
        <div id="comp-pricing" style="margin-bottom:64px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--border)">
            <h3 style="font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:3px;text-transform:uppercase;color:var(--text)">Pricing Cards</h3>
          </div>
          <p style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text-subtle);margin-bottom:28px;line-height:22px">
            Three variants driven by component-level tokens from <code style="font-family:monospace;font-size:12px;background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:3px;color:#22D2E6">colors-component-tokens/Mode 1</code>. Each card maps a distinct set of semantic tokens for header, body, price, and action button.
          </p>

          <div class="pricing-grid">

            <!-- STANDARD -->
            <div class="pricing-card">
              <div class="pricing-card-header" style="background:#002952">
                <div class="pricing-card-title" style="color:#EDFCFF">Standard</div>
                <div class="pricing-card-subtitle" style="color:rgba(237,252,255,0.6)">Full access plan</div>
              </div>
              <div class="pricing-card-body" style="background:#EDFCFF">
                <div class="pricing-price" style="color:#F05C5C">€9.99</div>
                <div class="pricing-period" style="color:#666">per month</div>
                <ul class="pricing-features" style="color:#000000">
                  <li>All live sports</li>
                  <li>HD streaming</li>
                  <li>Cancel anytime</li>
                </ul>
                <button class="pricing-btn" style="background:#002952">SUBSCRIBE NOW</button>
              </div>
              <div class="pricing-token-note">title-bg: #002952 &middot; title-text: #EDFCFF &middot; price: #F05C5C &middot; bg: #EDFCFF &middot; btn: #002952</div>
            </div>

            <!-- DEAL -->
            <div class="pricing-card">
              <div class="pricing-card-header" style="background:#F05C5C">
                <div class="pricing-card-title" style="color:#FFFFFF">Best Deal</div>
                <div class="pricing-card-subtitle" style="color:rgba(255,255,255,0.7)">Annual subscription</div>
              </div>
              <div class="pricing-card-body" style="background:#FFFFFF">
                <div class="pricing-price" style="color:#F05C5C">€6.99</div>
                <div class="pricing-period" style="color:#666">per month, billed annually</div>
                <ul class="pricing-features" style="color:#000000">
                  <li>All live sports</li>
                  <li>4K streaming</li>
                  <li>Exclusive content</li>
                </ul>
                <button class="pricing-btn" style="background:#F05C5C">GET THIS DEAL</button>
              </div>
              <div class="pricing-token-note" style="background:#FFFFFF">title-bg: #F05C5C &middot; title-text: #FFFFFF &middot; price: #F05C5C &middot; bg: #FFFFFF &middot; btn: #F05C5C</div>
            </div>

            <!-- VOUCHER -->
            <div class="pricing-card">
              <div class="pricing-card-header" style="background:#62FF98">
                <div class="pricing-card-title" style="color:#002952">Voucher</div>
                <div class="pricing-card-subtitle" style="color:rgba(0,41,82,0.6)">Redeem your code</div>
              </div>
              <div class="pricing-card-body" style="background:#FFFFFF">
                <div class="pricing-price" style="color:#F05C5C">FREE</div>
                <div class="pricing-period" style="color:#666">with valid voucher code</div>
                <ul class="pricing-features" style="color:#000000">
                  <li>30-day trial</li>
                  <li>All live sports</li>
                  <li>No credit card needed</li>
                </ul>
                <button class="pricing-btn" style="background:#62FF98;color:#002952">REDEEM VOUCHER</button>
              </div>
              <div class="pricing-token-note" style="background:#FFFFFF">title-bg: #62FF98 &middot; title-text: #002952 &middot; price: #F05C5C &middot; bg: #FFFFFF &middot; btn: #62FF98</div>
            </div>

          </div>
        </div>

        <!-- Coming Next -->
        <div>
          <div style="font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:3px;color:var(--text-subtle);margin-bottom:20px;text-transform:uppercase">Coming Next</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
            <div id="comp-forms" style="background:rgba(0,41,82,0.25);border:1px dashed rgba(255,255,255,0.08);border-radius:8px;padding:16px 18px;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:2px;color:rgba(237,252,255,0.35);text-transform:uppercase">Form</div>
            <div id="comp-headers" style="background:rgba(0,41,82,0.25);border:1px dashed rgba(255,255,255,0.08);border-radius:8px;padding:16px 18px;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:2px;color:rgba(237,252,255,0.35);text-transform:uppercase">Navigation Header</div>
            <div id="comp-steppers" style="background:rgba(0,41,82,0.25);border:1px dashed rgba(255,255,255,0.08);border-radius:8px;padding:16px 18px;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:2px;color:rgba(237,252,255,0.35);text-transform:uppercase">Stepper</div>
            <div id="comp-cards" style="background:rgba(0,41,82,0.25);border:1px dashed rgba(255,255,255,0.08);border-radius:8px;padding:16px 18px;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:2px;color:rgba(237,252,255,0.35);text-transform:uppercase">Match Card</div>
            <div id="comp-nav" style="background:rgba(0,41,82,0.25);border:1px dashed rgba(255,255,255,0.08);border-radius:8px;padding:16px 18px;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:2px;color:rgba(237,252,255,0.35);text-transform:uppercase">Navigation Patterns</div>
          </div>
        </div>

      </div>
    </div><!-- /panel-main (composite) -->
  </div><!-- /panel-shell (composite) -->
</div><!-- /#compositeComponentsPanel -->

<script>
// ===== TAB SWITCHING =====
(function() {
  var tabBtns = document.querySelectorAll('.tab-btn');
  var tabPanels = document.querySelectorAll('.tab-panel');

  // Map each tab to its sidebar ID
  var sidebarMap = {
    'updates':    'sidebarUpdates',
    'foundations':'sidebarFoundations',
    'core':       'sidebarCore',
    'composite':  'sidebarComposite'
  };

  function activateTab(target) {
    // Update button states
    tabBtns.forEach(function(b) {
      var isActive = b.getAttribute('data-tab') === target;
      b.classList.toggle('active', isActive);
      b.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    // Show/hide tab panels — only one visible at a time
    tabPanels.forEach(function(panel) {
      panel.style.display = panel.getAttribute('data-panel') === target ? 'block' : 'none';
    });

    // Hide all sidebars, then show only the active tab's sidebar
    Object.values(sidebarMap).forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
    var activeSidebar = document.getElementById(sidebarMap[target]);
    if (activeSidebar) activeSidebar.style.display = '';
  }

  tabBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      activateTab(btn.getAttribute('data-tab'));
    });
  });

  // Set initial state — Latest Updates is active by default
  activateTab('updates');
})();

// ===== THEME TOGGLE =====
function toggleTheme() {
  const body = document.body;
  const isLight = body.classList.toggle('light-mode');
  // Dark mode → show ☀ (click to go light)
  // Light mode → show ☾ (click to go dark)
  document.getElementById('headerThemeIcon').textContent = isLight ? '☾' : '☀';
  document.getElementById('headerThemeLabel').textContent = isLight ? 'Dark Mode' : 'Light Mode';
}

// ===== ACTIVE NAV (Foundations sidebar only) =====
const sections = document.querySelectorAll('#foundationsPanel section[id]');
const navLinks = document.querySelectorAll('#sideNavFoundations a');
function updateNav() {
  let current = '';
  sections.forEach(s => {
    if (window.scrollY >= s.offsetTop - 120) current = s.id;
  });
  navLinks.forEach(a => {
    a.classList.toggle('active', a.getAttribute('href') === '#' + current);
  });
}
window.addEventListener('scroll', updateNav, { passive: true });
updateNav();

// ===== WCAG CONTRAST =====
function hexToRgb(hex) {
  hex = hex.replace('#','');
  if (hex.length === 3) hex = hex.split('').map(c=>c+c).join('');
  const n = parseInt(hex, 16);
  return [(n>>16)&255, (n>>8)&255, n&255];
}
function linearize(c) {
  c /= 255;
  return c <= 0.04045 ? c/12.92 : Math.pow((c+0.055)/1.055, 2.4);
}
function luminance(hex) {
  const [r,g,b] = hexToRgb(hex).map(linearize);
  return 0.2126*r + 0.7152*g + 0.0722*b;
}
function contrast(fg, bg) {
  const l1 = luminance(fg), l2 = luminance(bg);
  const lighter = Math.max(l1,l2), darker = Math.min(l1,l2);
  return (lighter + 0.05) / (darker + 0.05);
}

const pairs = [
  { fg:'#EDFCFF', fgToken:'text/light', bg:'#00141E', bgToken:'brand/tertiary/dark', req:4.5 },
  { fg:'#EDFCFF', fgToken:'text/light', bg:'#006299', bgToken:'brand/primary/regular', req:4.5 },
  { fg:'#000000', fgToken:'text/dark', bg:'#FFFFFF', bgToken:'surface/light', req:4.5 },
  { fg:'#22D2E6', fgToken:'brand/secondary/strong', bg:'#00141E', bgToken:'brand/tertiary/dark', req:3 },
  { fg:'#62FF98', fgToken:'status/success', bg:'#00141E', bgToken:'brand/tertiary/dark', req:3 },
  { fg:'#F05C5C', fgToken:'status/error', bg:'#00141E', bgToken:'brand/tertiary/dark', req:3 },
  { fg:'#DF984B', fgToken:'status/warning', bg:'#00141E', bgToken:'brand/tertiary/dark', req:3 },
  { fg:'#F05C5C', fgToken:'text/price', bg:'#FFFFFF', bgToken:'surface/light', req:4.5 }
];

const tbody = document.getElementById('a11yBody');
pairs.forEach(p => {
  const ratio = contrast(p.fg, p.bg);
  const pass = ratio >= p.req;
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td><div class="color-chip"><div class="chip-dot" style="background:${p.fg}"></div>${p.fgToken}<br><span style="opacity:0.5">${p.fg}</span></div></td>
    <td><div class="color-chip"><div class="chip-dot" style="background:${p.bg}"></div>${p.bgToken}<br><span style="opacity:0.5">${p.bg}</span></div></td>
    <td><div class="preview-aa" style="background:${p.bg};color:${p.fg}">Aa</div></td>
    <td><span class="ratio-val">${ratio.toFixed(2)}:1</span></td>
    <td style="font-family:var(--mono);font-size:12px">${p.req}:1</td>
    <td><span class="badge ${pass?'badge-pass':'badge-fail'}">${pass?'PASS':'FAIL'}</span></td>
  `;
  tbody.appendChild(tr);
});
</script>
</body>
</html>
