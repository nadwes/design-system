<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>DYN Sports — Dark Mode Design System</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@300;400;500;700&family=Titillium+Web:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
/* ===== RESET ===== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

/* ===== CSS VARIABLES ===== */
:root {
  --bg: #00141E;
  --bg-surface: #002952;
  --bg-card: #002F60;
  --text: #EDFCFF;
  --text-subtle: #99AABB;
  --accent: #22D2E6;
  --accent2: #15B0D0;
  --border: rgba(193,209,225,0.2);
  --sidebar-bg: #00141E;
  --sidebar-accent: #22D2E6;
  --nav-width: 260px;
  --spacing-32: 32px;
  --spacing-page-header-top: var(--spacing-32);
  --mono: 'Courier New', 'Courier', monospace;
}
body.light-mode {
  --bg: #FFFFFF;
  --bg-surface: #F5F8FA;
  --bg-card: #E6EEF5;
  --text: #000000;
  --text-subtle: #666666;
  --accent: #006299;
  --accent2: #0B89B5;
  --border: rgba(0,0,0,0.12);
  --sidebar-bg: #002952;
  --sidebar-accent: #22D2E6;
}

/* ===== BASE ===== */
html { scroll-behavior: smooth; }
body {
  font-family: 'Titillium Web', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  transition: background 0.3s, color 0.3s;
}

/* ===== APP HEADER ===== */
.app-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 300;
  height: 56px;
  background: #002952;
  border-bottom: 1px solid rgba(34,210,230,0.15);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
}
.app-header-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 22px;
  letter-spacing: 4px;
  color: #22D2E6;
  text-transform: uppercase;
}
.app-header-theme {
  display: flex;
  align-items: center;
  gap: 10px;
}
.app-header-theme-label {
  font-family: 'Titillium Web', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: rgba(237,252,255,0.4);
}
.app-header-theme-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(34,210,230,0.1);
  border: 1px solid rgba(34,210,230,0.3);
  color: #EDFCFF;
  padding: 8px 18px;
  border-radius: 24px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 14px;
  letter-spacing: 4px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s;
}
.app-header-theme-toggle:hover {
  background: rgba(34,210,230,0.2);
  border-color: rgba(34,210,230,0.6);
}

/* ===== TAB BAR ===== */
.tab-bar {
  position: fixed;
  top: 56px; left: 0; right: 0;
  z-index: 290;
  height: 48px;
  background: #001f30;
  border-bottom: 1px solid rgba(34,210,230,0.12);
  display: flex;
  align-items: stretch;
  justify-content: center;
  padding: 0 32px;
  gap: 0;
}
.tab-btn {
  background: none;
  border: none;
  border-bottom: 3px solid transparent;
  color: rgba(237,252,255,0.5);
  font-family: 'Titillium Web', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
  padding: 0 20px;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
  white-space: nowrap;
}
.tab-btn:hover { 
  color: #EDFCFF; 
  background: rgba(255,255,255,0.04); 
}
.tab-btn.active {
  color: #22D2E6;
  border-bottom-color: #22D2E6;
  background: rgba(34,210,230,0.06);
}

/* ===== TAB PANELS ===== */
/* Hidden by default — see layout rules below */

/* ===== PER-TAB LAYOUT SHELL ===== */
/* Each panel that needs a sidebar uses this flex wrapper — see layout rules below */

/* ===== SIDEBAR ===== */
.sidebar {
  width: var(--nav-width);
  background: var(--sidebar-bg);
  position: fixed;
  top: 104px; left: 0; bottom: 0;
  overflow-y: auto;
  z-index: 200;
  border-right: 1px solid rgba(34,210,230,0.15);
  display: flex;
  flex-direction: column;
  transition: background 0.3s;
}
.sidebar-logo {
  padding: 24px 20px 20px;
  border-bottom: 1px solid rgba(34,210,230,0.15);
}
.sidebar-logo .brand {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 22px;
  letter-spacing: 3px;
  color: var(--sidebar-accent);
  text-transform: uppercase;
}
.sidebar-logo .version {
  font-family: 'Titillium Web', sans-serif;
  font-size: 11px;
  color: rgba(237,252,255,0.4);
  margin-top: 3px;
  letter-spacing: 1px;
}
.sidebar nav { padding: 12px 0; flex: 1; }
.sidebar nav a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 20px;
  font-family: 'Titillium Web', sans-serif;
  font-size: 12px;
  color: rgba(237,252,255,0.55);
  text-decoration: none;
  border-left: 3px solid transparent;
  transition: all 0.15s;
}
.sidebar nav a:hover { color: #EDFCFF; background: rgba(34,210,230,0.07); }
.sidebar nav a.active { color: var(--sidebar-accent); border-left-color: var(--sidebar-accent); background: rgba(34,210,230,0.08); }
.nav-num { font-size: 10px; opacity: 0.4; min-width: 18px; font-family: var(--mono); }

/* ===== MAIN (legacy — kept for reference) ===== */
/* .main { margin-left: var(--nav-width); flex: 1; min-width: 0; padding-top: 104px; } */

/* ===== HERO ===== */
.hero {
  background: linear-gradient(135deg, #00141E 0%, #002952 50%, #002F60 80%, #00141E 100%);
  padding: var(--spacing-page-header-top) 48px 56px;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -80px; right: -80px;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(34,210,230,0.12) 0%, transparent 65%);
  pointer-events: none;
}
.hero::after {
  content: '';
  position: absolute;
  bottom: -60px; left: 20%;
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(21,176,208,0.07) 0%, transparent 65%);
  pointer-events: none;
}
.hero-inner {
  position: relative; z-index: 1;
  display: flex; align-items: flex-start;
  justify-content: space-between; flex-wrap: wrap; gap: 24px;
}
.hero-eyebrow {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 14px; letter-spacing: 5px;
  color: var(--accent); text-transform: uppercase; margin-bottom: 8px;
}
.hero h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 80px; font-weight: 700;
  line-height: 74px; letter-spacing: 0;
  text-transform: uppercase; color: #EDFCFF;
}
.hero h1 span { color: var(--accent); }
.hero-subtitle {
  margin-top: 16px;
  font-family: 'Titillium Web', sans-serif;
  font-size: 16px; color: rgba(237,252,255,0.5);
  letter-spacing: 2px;
}
.theme-toggle {
  display: flex; align-items: center; gap: 8px;
  background: rgba(34,210,230,0.1);
  border: 1px solid rgba(34,210,230,0.3);
  color: #EDFCFF; padding: 10px 20px;
  border-radius: 24px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 16px; letter-spacing: 5px;
  text-transform: uppercase; cursor: pointer;
  transition: all 0.2s; align-self: center;
}
.theme-toggle:hover { background: rgba(34,210,230,0.2); border-color: rgba(34,210,230,0.6); }

/* ===== CONTENT ===== */
.content { 
  padding: 0 48px 80px;
  max-width: 1400px;
  margin: 0 auto;
}
.section { padding-top: 64px; }
.section-header {
  display: flex; align-items: baseline; gap: 14px;
  margin-bottom: 36px; padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}
.section-num {
  font-family: var(--mono); font-size: 11px; font-weight: 700;
  letter-spacing: 2px; color: var(--accent);
  background: rgba(34,210,230,0.1);
  padding: 3px 8px; border-radius: 4px;
}
.section-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 32px; font-weight: 700;
  letter-spacing: 3px; text-transform: uppercase;
  color: var(--text);
}

/* ===== SWATCHES ===== */
.palette-group { margin-bottom: 36px; }
.palette-group-label {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 16px; letter-spacing: 3px;
  text-transform: uppercase; color: var(--text-subtle);
  margin-bottom: 14px;
}
.swatch-grid { display: flex; flex-wrap: wrap; gap: 12px; }
.swatch {
  width: 130px; border-radius: 8px; overflow: hidden;
  border: 1px solid var(--border);
  background: var(--bg-surface);
}
.swatch-color { height: 80px; width: 100%; }
.swatch-info { padding: 10px 12px; }
.swatch-token {
  font-family: var(--mono); font-size: 10px;
  color: var(--text-subtle); word-break: break-all; line-height: 1.4;
}
.swatch-hex {
  font-family: var(--mono); font-size: 12px;
  font-weight: 700; color: var(--text); margin-top: 4px;
}

/* ===== SEMANTIC ROLES ===== */
.semantic-group { margin-bottom: 32px; }
.semantic-group-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 20px; letter-spacing: 2px;
  text-transform: uppercase; color: var(--accent);
  margin-bottom: 12px;
}
.semantic-row {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 16px; border-bottom: 1px solid var(--border);
  transition: background 0.1s;
}
.semantic-row:last-child { border-bottom: none; }
.semantic-row:hover { background: rgba(34,210,230,0.04); }
.color-dot {
  width: 22px; height: 22px; border-radius: 50%;
  flex-shrink: 0; border: 1px solid rgba(255,255,255,0.15);
}
.semantic-token-name {
  font-family: var(--mono); font-size: 12px;
  color: var(--text); flex: 1;
}
.semantic-hex {
  font-family: var(--mono); font-size: 11px; color: var(--text-subtle);
}

/* ===== SPORT CARDS ===== */
.sport-grid { display: flex; flex-wrap: wrap; gap: 20px; }
.sport-card {
  border-radius: 12px; overflow: hidden;
  border: 1px solid var(--border);
  background: var(--bg-surface);
  min-width: 200px; flex: 1;
}
.sport-card-header {
  padding: 16px 20px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 20px; letter-spacing: 3px;
  text-transform: uppercase; color: #EDFCFF;
}
.sport-swatches { display: flex; }
.sport-swatch { flex: 1; padding: 14px 16px; }
.sport-swatch-label {
  font-family: 'Titillium Web', sans-serif;
  font-size: 10px; letter-spacing: 1px;
  text-transform: uppercase; color: rgba(237,252,255,0.5);
  margin-bottom: 6px;
}
.sport-swatch-color {
  width: 36px; height: 36px; border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.15); margin-bottom: 6px;
}
.sport-swatch-hex {
  font-family: var(--mono); font-size: 11px; color: #EDFCFF;
}
.on-air-dot {
  display: inline-block; width: 8px; height: 8px;
  border-radius: 50%; background: #62FF98;
  margin-right: 5px; animation: pulse 1.5s infinite;
}
@keyframes pulse {
  0%,100%{opacity:1;transform:scale(1)}
  50%{opacity:0.5;transform:scale(1.3)}
}

/* ===== TYPOGRAPHY ===== */
.type-table { width: 100%; border-collapse: collapse; }
.type-row {
  display: grid;
  grid-template-columns: 180px 220px 1fr;
  gap: 24px; align-items: center;
  padding: 20px 0; border-bottom: 1px solid var(--border);
}
.type-row:last-child { border-bottom: none; }
.type-token {
  font-family: var(--mono); font-size: 12px;
  color: var(--accent); font-weight: 600;
}
.type-spec {
  font-family: var(--mono); font-size: 10px;
  color: var(--text-subtle); margin-top: 4px; line-height: 1.6;
}
.type-sample { color: var(--text); }

/* ===== SPACING ===== */
.spacing-list { display: flex; flex-direction: column; gap: 4px; }
.spacing-row {
  display: flex; align-items: center; gap: 16px; padding: 6px 0;
}
.spacing-label {
  min-width: 160px; font-family: var(--mono);
  font-size: 12px; color: var(--text-subtle);
}
.spacing-bar-wrap { flex: 1; display: flex; align-items: center; gap: 10px; }
.spacing-bar {
  height: 20px; background: var(--accent);
  border-radius: 3px; min-width: 2px; opacity: 0.7;
}
.spacing-px {
  font-family: var(--mono); font-size: 12px;
  font-weight: 700; color: var(--text);
}

/* ===== COMPONENT SPACING DIAGRAM ===== */
.comp-diagram {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: 12px; padding: 32px;
  margin-bottom: 24px;
}
.comp-diagram-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px; letter-spacing: 3px;
  text-transform: uppercase; color: var(--accent);
  margin-bottom: 20px;
}
.header-mock {
  background: #002952;
  border: 2px dashed rgba(34,210,230,0.4);
  border-radius: 8px; padding: 0 16px;
  display: flex; align-items: center;
  gap: 0; position: relative; min-height: 56px;
}
.header-mock-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 20px; letter-spacing: 3px;
  color: #22D2E6; margin-right: auto;
}
.nav-item-mock {
  padding: 0; padding-bottom: 8px; gap: 16px;
  display: flex; align-items: center;
  border-bottom: 2px solid rgba(34,210,230,0.3);
  margin: 0 8px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 14px; letter-spacing: 2px;
  color: rgba(237,252,255,0.7); text-transform: uppercase;
  position: relative;
}
.annotation {
  font-family: var(--mono); font-size: 10px;
  color: #22D2E6; background: rgba(34,210,230,0.1);
  border: 1px solid rgba(34,210,230,0.3);
  padding: 2px 6px; border-radius: 3px;
  white-space: nowrap;
}
.spacing-table {
  width: 100%; border-collapse: collapse;
  font-family: var(--mono); font-size: 12px;
}
.spacing-table th {
  text-align: left; padding: 8px 12px;
  color: var(--text-subtle); font-size: 10px;
  letter-spacing: 1px; text-transform: uppercase;
  border-bottom: 1px solid var(--border);
}
.spacing-table td {
  padding: 10px 12px; border-bottom: 1px solid var(--border);
  color: var(--text);
}
.spacing-table tr:last-child td { border-bottom: none; }
.spacing-table .val { color: var(--accent); font-weight: 700; }

/* ===== STROKE & RADIUS ===== */
.stroke-section { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
.stroke-group-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 20px; letter-spacing: 2px;
  text-transform: uppercase; color: var(--text);
  margin-bottom: 20px;
}
.border-row {
  display: flex; align-items: center; gap: 20px;
  padding: 14px 0; border-bottom: 1px solid var(--border);
}
.border-row:last-child { border-bottom: none; }
.border-label {
  min-width: 180px; font-family: var(--mono);
  font-size: 12px; color: var(--text-subtle);
}
.border-line-wrap { flex: 1; }
.border-line { background: var(--text); width: 100%; }
.radius-grid { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-end; }
.radius-item { display: flex; flex-direction: column; align-items: center; gap: 12px; }
.radius-box {
  width: 80px; height: 80px;
  background: linear-gradient(135deg, var(--accent), #006299);
}
.radius-token {
  font-family: var(--mono); font-size: 11px;
  color: var(--text-subtle); display: block; text-align: center;
}
.radius-val {
  font-family: var(--mono); font-size: 13px;
  font-weight: 700; color: var(--text);
  display: block; text-align: center; margin-top: 2px;
}

/* ===== EFFECTS ===== */
.effects-grid { display: flex; flex-wrap: wrap; gap: 24px; }
.overlay-card {
  border-radius: 12px; overflow: hidden;
  width: 200px; height: 140px; position: relative;
  flex-shrink: 0;
}
.overlay-bg {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, #006299, #22D2E6, #1BE0C3);
}
.overlay-layer {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 6px;
}
.overlay-label {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 14px; letter-spacing: 2px;
  text-transform: uppercase; color: #EDFCFF;
  text-shadow: 0 1px 3px rgba(0,0,0,0.5);
}
.overlay-pct {
  font-family: var(--mono); font-size: 11px;
  color: rgba(237,252,255,0.8);
}
.glass-card {
  border-radius: 12px; padding: 24px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.2);
  backdrop-filter: blur(8px);
  font-family: 'Titillium Web', sans-serif;
  font-size: 14px; color: var(--text);
}
.glass-card-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px; letter-spacing: 2px;
  text-transform: uppercase; color: var(--accent);
  margin-bottom: 8px;
}

/* ===== ACCESSIBILITY ===== */
.a11y-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.a11y-table th {
  text-align: left; padding: 10px 14px;
  font-family: var(--mono); font-size: 10px;
  font-weight: 700; letter-spacing: 1px;
  text-transform: uppercase; color: var(--text-subtle);
  border-bottom: 2px solid var(--border);
  background: var(--bg-surface);
}
.a11y-table td {
  padding: 12px 14px; border-bottom: 1px solid var(--border);
  vertical-align: middle;
}
.a11y-table tr:last-child td { border-bottom: none; }
.a11y-table tr:hover td { background: rgba(34,210,230,0.03); }
.color-chip {
  display: inline-flex; align-items: center;
  gap: 6px; font-family: var(--mono); font-size: 11px;
}
.chip-dot {
  width: 14px; height: 14px; border-radius: 3px;
  border: 1px solid rgba(255,255,255,0.15); flex-shrink: 0;
}
.preview-aa {
  display: inline-flex; align-items: center;
  justify-content: center; width: 44px; height: 28px;
  border-radius: 5px; font-size: 14px; font-weight: 700;
  font-family: 'Titillium Web', sans-serif;
}
.ratio-val {
  font-weight: 700; font-family: var(--mono); font-size: 14px;
}
.badge {
  display: inline-block; padding: 3px 10px;
  border-radius: 20px; font-size: 10px;
  font-weight: 700; letter-spacing: 1px;
  text-transform: uppercase; font-family: var(--mono);
}
.badge-pass { background: rgba(98,255,152,0.15); color: #62FF98; border: 1px solid rgba(98,255,152,0.3); }
.badge-fail { background: rgba(240,92,92,0.15); color: #F05C5C; border: 1px solid rgba(240,92,92,0.3); }

/* ===== TOKEN HIERARCHY ===== */
.hierarchy-flow {
  display: flex; align-items: center;
  gap: 0; flex-wrap: wrap; margin-bottom: 48px;
}
.hier-level { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.hier-box {
  padding: 12px 24px; border-radius: 8px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 16px; letter-spacing: 2px;
  text-align: center; min-width: 160px;
}
.hier-box.primitive {
  background: rgba(34,210,230,0.1);
  border: 2px solid #22D2E6; color: #22D2E6;
}
.hier-box.global {
  background: rgba(21,176,208,0.1);
  border: 2px solid #15B0D0; color: #15B0D0;
}
.hier-box.component {
  background: rgba(98,255,152,0.1);
  border: 2px solid #62FF98; color: #62FF98;
}
.hier-label {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 1px; text-transform: uppercase;
  color: var(--text-subtle);
}
.hier-arrow {
  font-size: 24px; color: var(--text-subtle);
  padding: 0 16px; margin-top: -20px;
}
.hier-example {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: 12px; padding: 24px 32px;
  display: flex; align-items: center;
  gap: 0; flex-wrap: wrap;
}
.hier-ex-step { display: flex; flex-direction: column; gap: 4px; }
.hier-ex-label {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 1px; text-transform: uppercase;
  color: var(--text-subtle);
}
.hier-ex-value {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 13px;
  color: var(--text); font-weight: 600;
}
.hier-ex-dot {
  width: 18px; height: 18px; border-radius: 4px;
  border: 1px solid rgba(255,255,255,0.15); flex-shrink: 0;
}
.hier-ex-arrow {
  font-size: 20px; color: var(--text-subtle);
  padding: 0 20px; margin-top: 14px;
}

/* ===== PRICING CARDS ===== */
.pricing-grid { display: flex; flex-wrap: wrap; gap: 24px; }
.pricing-card {
  border-radius: 12px; overflow: hidden;
  flex: 1; min-width: 240px; max-width: 320px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}
.pricing-card-header {
  padding: 24px 24px 20px;
}
.pricing-card-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 24px; letter-spacing: 3px;
  text-transform: uppercase; margin-bottom: 4px;
}
.pricing-card-subtitle {
  font-family: 'Titillium Web', sans-serif;
  font-size: 12px; opacity: 0.7;
}
.pricing-card-body { padding: 24px; }
.pricing-price {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 48px; line-height: 1;
  margin-bottom: 4px;
}
.pricing-period {
  font-family: 'Titillium Web', sans-serif;
  font-size: 12px; color: #666; margin-bottom: 20px;
}
.pricing-features {
  font-family: 'Titillium Web', sans-serif;
  font-size: 14px; line-height: 22px;
  margin-bottom: 24px; color: #333;
}
.pricing-features li { list-style: none; padding: 4px 0; }
.pricing-features li::before { content: "✓ "; font-weight: 700; }
.pricing-btn {
  display: block; width: 100%;
  padding: 12px 24px; border: none;
  border-radius: 8px; cursor: pointer;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 16px; letter-spacing: 5px;
  text-transform: uppercase; color: #EDFCFF;
  transition: opacity 0.2s;
}
.pricing-btn:hover { opacity: 0.85; }
.pricing-token-note {
  font-family: var(--mono); font-size: 10px;
  color: var(--text-subtle); margin-top: 8px;
  padding: 0 24px 16px;
}

/* ===== SCROLLBAR ===== */
.sidebar::-webkit-scrollbar { width: 4px; }
.sidebar::-webkit-scrollbar-track { background: transparent; }
.sidebar::-webkit-scrollbar-thumb { background: rgba(34,210,230,0.2); border-radius: 2px; }

/* ===== FOUNDATIONS SUB-NAV ===== */
/* Top-level nav group label */
.nav-group-label {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px 6px;
  font-family: 'Titillium Web', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: rgba(237,252,255,0.85);
  text-decoration: none;
  border-left: 3px solid transparent;
  transition: all 0.15s;
  cursor: pointer;
}
.nav-group-label:hover { color: #EDFCFF; background: rgba(34,210,230,0.07); }
.nav-group-label.active { color: var(--sidebar-accent); border-left-color: var(--sidebar-accent); background: rgba(34,210,230,0.08); }

/* Sub-nav items */
.nav-sub-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 20px 6px 36px;
  font-family: 'Titillium Web', sans-serif;
  font-size: 11px;
  color: rgba(237,252,255,0.42);
  text-decoration: none;
  border-left: 3px solid transparent;
  transition: all 0.15s;
}
.nav-sub-item:hover { color: rgba(237,252,255,0.8); background: rgba(34,210,230,0.05); }
.nav-sub-item.active { color: var(--sidebar-accent); border-left-color: var(--sidebar-accent); background: rgba(34,210,230,0.06); }

/* Nav group separator */
.nav-group-sep {
  height: 1px;
  background: rgba(34,210,230,0.08);
  margin: 6px 20px;
}

/* ===== LAYOUT — documented breakpoints ===== */
/*
  Mobile  (default) : 0px+   · 4 cols  · 16px gutter · 16px padding-x
  Tablet  (768px)   : md:    · 8 cols  · 16px gutter · 24px padding-x
  Desktop (1280px)  : xl:    · 12 cols · 24px gutter · 48px padding-x
  Wide    (1536px)  : 2xl:   · 12 cols · 24px gutter · 48px (frozen)
*/

/* ── Tab panels: hidden by default ── */
.tab-panel { display: none; }

/* ── Panel shell: sidebar + content side by side ── */
.panel-shell {
  display: flex;
  min-height: calc(100vh - 104px);
}

/* ── Panel main content area ──
   Offset by sidebar width, push below fixed header+tabbar (104px).
   No horizontal padding here — inner containers handle their own padding.
── */
.panel-main {
  margin-left: var(--nav-width);
  flex: 1;
  min-width: 0;
  padding-top: 104px;
  padding-bottom: 80px;
}

/* ── Content container inside panel-main: adds horizontal padding and caps width ── */
.panel-content {
  padding-top: var(--spacing-page-header-top);
  padding-left: 48px;
  padding-right: 48px;
  max-width: calc(1200px + 96px); /* 1200px content + 2×48px padding */
}

/* ── Latest Updates: sidebar is present, same offset ── */
#latestUpdatesPanel .panel-main {
  margin-left: var(--nav-width);
}

/* ── Foundations hero: full-bleed, no horizontal padding ── */
.panel-main .hero {
  padding-left: 48px;
  padding-right: 48px;
}

/* ── Content wrapper inside panel-main ── */
.panel-main .content {
  padding-left: 48px;
  padding-right: 48px;
  max-width: none;
}

/* ── Responsive: tablet 768px ── */
@media (min-width: 768px) {
  .panel-main .hero,
  .panel-main .content,
  .panel-content {
    padding-left: 32px;
    padding-right: 32px;
  }
}

/* ── Responsive: desktop 1280px ── */
@media (min-width: 1280px) {
  .panel-main .hero,
  .panel-main .content,
  .panel-content {
    padding-left: 48px;
    padding-right: 48px;
  }
  .type-row { grid-template-columns: 180px 220px 1fr; }
  .stroke-section { grid-template-columns: 1fr 1fr; }
}

/* ── Responsive: mobile — hide sidebar, remove offset ── */
@media (max-width: 767px) {
  :root { --nav-width: 0px; }
  .sidebar { display: none !important; }
  .panel-main {
    margin-left: 0;
  }
  .panel-main .hero,
  .panel-main .content,
  .panel-content {
    padding-left: 16px;
    padding-right: 16px;
  }
  .hero h1 { font-size: 56px; line-height: 56px; }
  .type-row { grid-template-columns: 1fr; gap: 8px; }
  .stroke-section { grid-template-columns: 1fr; }
  .app-header-title { font-size: 16px; letter-spacing: 2px; }
  .tab-btn { font-size: 11px; padding: 0 12px; }
}
</style>
</head>
<body>

<!-- ═══ APP HEADER ════════════════════════════════════════════════════ -->
<header class="app-header">
  <span class="app-header-title">DYN MEDIA | DESIGN SYSTEM</span>
  <div class="app-header-theme">
    <button class="app-header-theme-toggle" id="headerThemeToggle" onclick="toggleTheme()">
      <span id="headerThemeIcon">☀</span>
      <span id="headerThemeLabel">Light Mode</span>
    </button>
  </div>
</header>

<!-- ═══ TAB BAR ════════════════════════════════════════════════════════ -->
<nav class="tab-bar" id="tabBar" role="tablist">
  <button class="tab-btn active" role="tab" aria-selected="true"  data-tab="updates">Latest Updates</button>
  <button class="tab-btn"        role="tab" aria-selected="false" data-tab="foundations">Foundations</button>
  <button class="tab-btn"        role="tab" aria-selected="false" data-tab="core">Core Components</button>
  <button class="tab-btn"        role="tab" aria-selected="false" data-tab="composite">Composite Components</button>
</nav>

<!-- ═══════════════════════════════════════════════════════════════════
     TAB PANEL: LATEST UPDATES
════════════════════════════════════════════════════════════════════ -->
<div class="tab-panel" id="latestUpdatesPanel" data-panel="updates">
  <div class="panel-shell">
    <!-- Latest Updates sidebar: week periods only -->
    <aside class="sidebar" id="sidebarUpdates">
      <nav>
        <a href="#week19" class="active"><span class="nav-num">→</span> Week 19 | 2026</a>
        <a href="#week18"><span class="nav-num">→</span> Week 18 | 2026</a>
        <a href="#week17"><span class="nav-num">→</span> Week 17 | 2026</a>
      </nav>
    </aside>
    <!-- Latest Updates main content -->
    <div class="panel-main">
      <div class="panel-content">
        <h2 class="section-title">Latest Updates</h2>
        <p style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text-subtle);margin-bottom:40px;line-height:22px">
          Human-readable feed of all design system changes, grouped by week and category.
        </p>

        <!-- Week 19 -->
        <div id="week19" style="font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:3px;color:#EDFCFF;margin:40px 0 20px;padding-bottom:10px;border-bottom:2px solid rgba(34,210,230,0.3)">
          Week 19 &nbsp;|&nbsp; Wednesday &nbsp;|&nbsp; May 6, 2026
        </div>

        <div style="background:rgba(0,41,82,0.35);border:1px solid rgba(255,255,255,0.07);border-radius:8px;padding:16px 20px;margin-bottom:12px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
            <span style="display:inline-block;font-size:10px;font-weight:700;padding:3px 9px;border-radius:4px;letter-spacing:0.8px;text-transform:uppercase;background:rgba(0,98,153,0.45);color:#8AD8EB">Documentation / HTML Page</span>
          </div>
          <p style="font-size:13px;color:#C1D1E1;line-height:1.7">
            <strong style="color:#EDFCFF">Tab architecture refactored.</strong> Separated global layout from per-tab content and contextual side navigation. Each tab now has its own independent panel and sidebar. Latest Updates shows week periods, Foundations shows foundation sections, Core Components shows component sections, Composite Components shows composite sections. Pricing Cards moved to Composite Components.
          </p>
        </div>

        <div style="background:rgba(0,41,82,0.35);border:1px solid rgba(255,255,255,0.07);border-radius:8px;padding:16px 20px;margin-bottom:12px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
            <span style="display:inline-block;font-size:10px;font-weight:700;padding:3px 9px;border-radius:4px;letter-spacing:0.8px;text-transform:uppercase;background:rgba(0,98,153,0.45);color:#8AD8EB">Foundations / Theme</span>
          </div>
          <p style="font-size:13px;color:#C1D1E1;line-height:1.7">
            <strong style="color:#EDFCFF">Navigation structure redesigned.</strong> Added top header with "DYN MEDIA | DESIGN SYSTEM" title and Active Theme toggle. Added horizontal tab navigation for Latest Updates, Foundations, Core Components, and Composite Components.
          </p>
        </div>

        <div style="background:rgba(0,41,82,0.35);border:1px solid rgba(255,255,255,0.07);border-radius:8px;padding:16px 20px;margin-bottom:12px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
            <span style="display:inline-block;font-size:10px;font-weight:700;padding:3px 9px;border-radius:4px;letter-spacing:0.8px;text-transform:uppercase;background:rgba(0,98,153,0.45);color:#8AD8EB">Foundations / Layout</span>
          </div>
          <p style="font-size:13px;color:#C1D1E1;line-height:1.7">
            <strong style="color:#EDFCFF">Grid system &amp; layout section added.</strong> Breakpoints documented: Mobile (0px), Tablet (768px / <code style="font-family:monospace;font-size:12px;background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:3px;color:#22D2E6">md:</code>), Desktop (1280px / <code style="font-family:monospace;font-size:12px;background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:3px;color:#22D2E6">xl:</code>), Wide (1536px / <code style="font-family:monospace;font-size:12px;background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:3px;color:#22D2E6">2xl:</code>). Content wrapper uses <code style="font-family:monospace;font-size:12px;background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:3px;color:#22D2E6">max-w-screen-2xl</code>.
          </p>
        </div>

        <div style="background:rgba(0,41,82,0.35);border:1px solid rgba(255,255,255,0.07);border-radius:8px;padding:16px 20px;margin-bottom:12px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
            <span style="display:inline-block;font-size:10px;font-weight:700;padding:3px 9px;border-radius:4px;letter-spacing:0.8px;text-transform:uppercase;background:rgba(0,98,153,0.45);color:#8AD8EB">Foundations / Layout</span>
          </div>
          <p style="font-size:13px;color:#C1D1E1;line-height:1.7">
            <strong style="color:#EDFCFF">Media aspect ratio tokens added.</strong> Seven ratio tokens defined: 16:9 (hero, player, thumbnail), 21:9 (cinematic hero), 3:2 (editorial), 1:1 (square avatar, split-screen). Minimum source resolutions documented for each.
          </p>
        </div>

        <div style="background:rgba(0,41,82,0.35);border:1px solid rgba(255,255,255,0.07);border-radius:8px;padding:16px 20px;margin-bottom:12px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
            <span style="display:inline-block;font-size:10px;font-weight:700;padding:3px 9px;border-radius:4px;letter-spacing:0.8px;text-transform:uppercase;background:rgba(0,98,153,0.45);color:#8AD8EB">Foundations / Theme</span>
          </div>
          <p style="font-size:13px;color:#C1D1E1;line-height:1.7">
            <strong style="color:#EDFCFF">Initial design system release for DYN Sports (Dark Mode).</strong> Figma token files exported and committed: primitives, colors-global, colors-component-tokens, effects-global, spacings-global, stroke-global, typos-global. HTML preview launched with all foundation tokens, WCAG checks, token hierarchy, and pricing card component tokens.
          </p>
        </div>

        <!-- Week 18 placeholder -->
        <div id="week18" style="font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:3px;color:#EDFCFF;margin:40px 0 20px;padding-bottom:10px;border-bottom:2px solid rgba(34,210,230,0.3)">
          Week 18 &nbsp;|&nbsp; 2026
        </div>
        <div style="background:rgba(0,41,82,0.2);border:1px dashed rgba(255,255,255,0.06);border-radius:8px;padding:16px 20px;margin-bottom:12px;font-family:'Titillium Web',sans-serif;font-size:13px;color:rgba(237,252,255,0.3)">
          No updates logged for this week.
        </div>

        <!-- Week 17 placeholder -->
        <div id="week17" style="font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:3px;color:#EDFCFF;margin:40px 0 20px;padding-bottom:10px;border-bottom:2px solid rgba(34,210,230,0.3)">
          Week 17 &nbsp;|&nbsp; 2026
        </div>
        <div style="background:rgba(0,41,82,0.2);border:1px dashed rgba(255,255,255,0.06);border-radius:8px;padding:16px 20px;margin-bottom:12px;font-family:'Titillium Web',sans-serif;font-size:13px;color:rgba(237,252,255,0.3)">
          No updates logged for this week.
        </div>

      </div>
    </div><!-- /panel-main -->
  </div><!-- /panel-shell -->
</div><!-- /#latestUpdatesPanel -->

<!-- ═══════════════════════════════════════════════════════════════════
     TAB PANEL: FOUNDATIONS
════════════════════════════════════════════════════════════════════ -->
<div class="tab-panel" id="foundationsPanel" data-panel="foundations">
  <div class="panel-shell">
    <!-- Foundations sidebar -->
    <aside class="sidebar" id="sidebarFoundations">
      <nav id="sideNavFoundations">

        <!-- COLOR -->
        <a href="#color-overview" class="nav-group-label active">Color</a>
