      </nav>
    </aside>
    <!-- Foundations main content -->
    <div class="panel-main">

<!-- HERO -->
<section class="hero" id="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-eyebrow">Foundations</div>
      <h1>DYN <span>Design</span></h1>
      <div class="hero-subtitle">Color &nbsp;&middot;&nbsp; Typography &nbsp;&middot;&nbsp; Spacing &nbsp;&middot;&nbsp; Layout</div>
    </div>
  </div>
</section>

<div class="content">

<!-- TOKEN HIERARCHY REFERENCE (kept for reference, not in main nav) -->
<section class="section" id="s-token-intro">
  <div class="section-header">
    <span class="section-num">00</span>
    <h2 class="section-title">Token Hierarchy</h2>
  </div>

  <p style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text-subtle);margin-bottom:32px;line-height:22px;max-width:720px">
    Every token in Foundations follows a strict three-level model. This is the backbone of the entire token system.
  </p>

  <div class="hierarchy-flow">
    <div class="hier-level">
      <div class="hier-box primitive">Primitive</div>
      <div class="hier-label">Raw values</div>
    </div>
    <div class="hier-arrow">&rarr;</div>
    <div class="hier-level">
      <div class="hier-box global">Global</div>
      <div class="hier-label">Semantic roles</div>
    </div>
    <div class="hier-arrow">&rarr;</div>
    <div class="hier-level">
      <div class="hier-box component">Component</div>
      <div class="hier-label">Usage context</div>
    </div>
  </div>

  <div class="hier-example">
    <div class="hier-ex-step">
      <div class="hier-ex-label">Primitive</div>
      <div class="hier-ex-value">
        <div class="hier-ex-dot" style="background:#006299"></div>
        blue500 &mdash; #006299
      </div>
    </div>
    <div class="hier-ex-arrow">&rarr;</div>
    <div class="hier-ex-step">
      <div class="hier-ex-label">Global (Dark Mode)</div>
      <div class="hier-ex-value">
        <div class="hier-ex-dot" style="background:#006299"></div>
        brand/primary-colors/regular
      </div>
    </div>
    <div class="hier-ex-arrow">&rarr;</div>
    <div class="hier-ex-step">
      <div class="hier-ex-label">Component</div>
      <div class="hier-ex-value">
        <div class="hier-ex-dot" style="background:#006299"></div>
        card/pricing/standard/action-button
      </div>
    </div>
  </div>

  <div style="margin-top:32px;padding:20px 24px;background:rgba(34,210,230,0.06);border-left:3px solid #22D2E6;border-radius:6px">
    <div style="font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:2px;text-transform:uppercase;color:#22D2E6;margin-bottom:8px">Key Principles</div>
    <ul style="font-family:'Titillium Web',sans-serif;font-size:13px;color:var(--text);line-height:22px;list-style:none;padding:0">
      <li style="padding:4px 0"><strong style="color:#22D2E6">Primitive:</strong> Raw values with no semantic meaning. Never used directly in components.</li>
      <li style="padding:4px 0"><strong style="color:#22D2E6">Global (Semantic):</strong> Named roles that reference primitives. Express intent, not appearance.</li>
      <li style="padding:4px 0"><strong style="color:#22D2E6">Component:</strong> Scoped overrides that reference semantic roles. Defined per component.</li>
    </ul>
  </div>
</section>

<!-- SECTION 01: COLOR — PRIMITIVES -->
<section class="section" id="s01">
  <div class="section-header">
    <span class="section-num">01</span>
    <h2 class="section-title">Color</h2>
  </div>

  <p style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text-subtle);margin-bottom:32px;line-height:22px;max-width:720px">
    Color is structured in two levels following the token hierarchy. <strong style="color:var(--text)">Primitives</strong> are raw palette values with no semantic meaning. <strong style="color:var(--text)">Global Roles</strong> are semantic aliases that reference primitives and express intent.
  </p>

  <div style="font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:3px;text-transform:uppercase;color:var(--accent);margin-bottom:20px">Primitives — Raw Palette</div>

  <div class="palette-group">
    <div class="palette-group-label">Cool Neutrals</div>
    <div class="swatch-grid">
      <div class="swatch"><div class="swatch-color" style="background:#EDFCFF;border-bottom:1px solid #C1D1E1"></div><div class="swatch-info"><div class="swatch-token">neutral-cool-0</div><div class="swatch-hex">#EDFCFF</div></div></div>
