<div class="tab-panel" id="coreComponentsPanel" data-panel="core">
  <div class="panel-shell">
    <!-- Core Components sidebar -->
    <aside class="sidebar" id="sidebarCore">
      <nav>
        <a href="#core-buttons" class="active"><span class="nav-num">01</span> Buttons</a>
