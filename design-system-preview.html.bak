    <div class="spacing-row"><div class="spacing-label">spacing-2 &nbsp;&mdash; 2px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:2px"></div><span class="spacing-px">2px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-4 &nbsp;&mdash; 4px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:4px"></div><span class="spacing-px">4px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-8 &nbsp;&mdash; 8px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:8px"></div><span class="spacing-px">8px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-12 &mdash; 12px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:12px"></div><span class="spacing-px">12px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-16 &mdash; 16px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:16px"></div><span class="spacing-px">16px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-24 &mdash; 24px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:24px"></div><span class="spacing-px">24px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-32 &mdash; 32px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:32px"></div><span class="spacing-px">32px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-40 &mdash; 40px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:40px"></div><span class="spacing-px">40px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-48 &mdash; 48px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:48px"></div><span class="spacing-px">48px</span></div></div>
    <div class="spacing-row"><div class="spacing-label">spacing-64 &mdash; 64px</div><div class="spacing-bar-wrap"><div class="spacing-bar" style="width:64px"></div><span class="spacing-px">64px</span></div></div>
  </div>
</section>

<!-- SECTION 06: COMPONENT SPACINGS -->
<section class="section" id="s06">
  <div class="section-header">
    <span class="section-num">06</span>
    <h2 class="section-title">Component Spacings</h2>
  </div>

  <div class="comp-diagram">
    <div class="comp-diagram-title">Header Component</div>
    <div class="header-mock">
      <div class="header-mock-logo">DYN</div>
      <div class="nav-item-mock">Live <span class="annotation">gap: 16px</span></div>
      <div class="nav-item-mock">Sports <span class="annotation">pb: 8px</span></div>
      <div class="nav-item-mock">Schedule</div>
    </div>
    <div style="margin-top:12px;font-family:var(--mono);font-size:11px;color:var(--text-subtle)">
      Header: padding 0/16/0/16 &nbsp;&middot;&nbsp; gap: 0 &nbsp;&middot;&nbsp; Nav item: padding-bottom 8px, gap 16px &nbsp;&middot;&nbsp; Stepper item: padding-top 2px, padding-bottom 8px
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:8px">
    <div class="comp-diagram">
      <div class="comp-diagram-title">Card / Navigation / Desktop</div>
      <table class="spacing-table">
        <tr><th>Property</th><th>Value</th><th>Token</th></tr>
        <tr><td>padding-top</td><td class="val">4px</td><td>spacing-4</td></tr>
        <tr><td>padding-right</td><td class="val">8px</td><td>spacing-8</td></tr>
        <tr><td>padding-bottom</td><td class="val">4px</td><td>spacing-4</td></tr>
        <tr><td>padding-left</td><td class="val">8px</td><td>spacing-8</td></tr>
        <tr><td>gap</td><td class="val">16px</td><td>spacing-16</td></tr>
      </table>
    </div>
    <div class="comp-diagram">
      <div class="comp-diagram-title">Card / Navigation / Mobile</div>
      <table class="spacing-table">
        <tr><th>Property</th><th>Value</th><th>Token</th></tr>
        <tr><td>padding-top</td><td class="val">8px</td><td>spacing-8</td></tr>
        <tr><td>padding-right</td><td class="val">0px</td><td>spacing-0</td></tr>
        <tr><td>padding-bottom</td><td class="val">8px</td><td>spacing-8</td></tr>
        <tr><td>padding-left</td><td class="val">0px</td><td>spacing-0</td></tr>
        <tr><td>gap</td><td class="val">8px</td><td>spacing-8</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- SECTION 07: STROKE & BORDER RADIUS -->
<section class="section" id="s07">
  <div class="section-header">
    <span class="section-num">07</span>
    <h2 class="section-title">Stroke &amp; Border Radius</h2>
  </div>
  <div class="stroke-section">
    <div>
      <div class="stroke-group-title">Border Widths</div>
      <div class="border-row">
        <div class="border-label">width.hairline &mdash; 1px</div>
        <div class="border-line-wrap"><div class="border-line" style="height:1px"></div></div>
      </div>
      <div class="border-row">
        <div class="border-label">width.thin &mdash; 2px</div>
        <div class="border-line-wrap"><div class="border-line" style="height:2px"></div></div>
      </div>
      <div class="border-row">
        <div class="border-label">width.medium &mdash; 4px</div>
        <div class="border-line-wrap"><div class="border-line" style="height:4px"></div></div>
      </div>
    </div>
    <div>
      <div class="stroke-group-title">Corner Radius</div>
      <div class="radius-grid">
        <div class="radius-item">
          <div class="radius-box" style="border-radius:4px"></div>
          <div class="radius-label">
            <span class="radius-token">corner-radius.sm</span>
            <span class="radius-val">4px</span>
          </div>
        </div>
        <div class="radius-item">
          <div class="radius-box" style="border-radius:8px"></div>
          <div class="radius-label">
            <span class="radius-token">corner-radius.md</span>
            <span class="radius-val">8px</span>
          </div>
        </div>
        <div class="radius-item">
          <div class="radius-box" style="border-radius:24px"></div>
          <div class="radius-label">
            <span class="radius-token">corner-radius.lg</span>
            <span class="radius-val">24px</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 08: EFFECTS & OVERLAYS -->
<section class="section" id="s08">
  <div class="section-header">
    <span class="section-num">08</span>
    <h2 class="section-title">Effects &amp; Overlays</h2>
  </div>

  <div style="margin-bottom:32px">
    <div class="palette-group-label" style="margin-bottom:16px">Overlay Backdrops</div>
    <div class="effects-grid">
      <div>
        <div class="overlay-card">
          <div class="overlay-bg"></div>
          <div class="overlay-layer" style="background:rgba(0,0,0,0.24)">
            <div class="overlay-label">Subtle</div>
            <div class="overlay-pct">rgba(0,0,0,0.24)</div>
          </div>
        </div>
        <div style="font-family:var(--mono);font-size:10px;color:var(--text-subtle);margin-top:8px">overlay/backdrop/subtle</div>
      </div>
      <div>
        <div class="overlay-card">
          <div class="overlay-bg"></div>
          <div class="overlay-layer" style="background:rgba(0,0,0,0.4)">
            <div class="overlay-label">Default</div>
            <div class="overlay-pct">rgba(0,0,0,0.4)</div>
          </div>
        </div>
        <div style="font-family:var(--mono);font-size:10px;color:var(--text-subtle);margin-top:8px">overlay/backdrop/default</div>
      </div>
      <div>
        <div class="overlay-card">
          <div class="overlay-bg"></div>
          <div class="overlay-layer" style="background:rgba(0,0,0,0.6)">
            <div class="overlay-label">Strong</div>
            <div class="overlay-pct">rgba(0,0,0,0.6)</div>
          </div>
        </div>
        <div style="font-family:var(--mono);font-size:10px;color:var(--text-subtle);margin-top:8px">overlay/backdrop/strong</div>
      </div>
    </div>
  </div>

  <div>
    <div class="palette-group-label" style="margin-bottom:16px">Glass Stroke</div>
    <div style="display:flex;gap:24px;flex-wrap:wrap">
      <div>
        <div class="glass-card" style="width:280px">
          <div class="glass-card-title">Glass Card</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text)">
            Background: rgba(255,255,255,0.08)<br>
            Border: rgba(255,255,255,0.2) — glass/stroke
          </div>
        </div>
        <div style="font-family:var(--mono);font-size:10px;color:var(--text-subtle);margin-top:8px">glass/stroke &rarr; rgba(255,255,255,0.2)</div>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 09: ACCESSIBILITY -->
<section class="section" id="s09">
  <div class="section-header">
    <span class="section-num">09</span>
    <h2 class="section-title">Accessibility Check Panel</h2>
  </div>
