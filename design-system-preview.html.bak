<!-- SECTION 10: TOKEN HIERARCHY -->
<section class="section" id="s10">
  <div class="section-header">
    <span class="section-num">10</span>
    <h2 class="section-title">Token Hierarchy</h2>
  </div>

  <div class="hierarchy-flow">
    <div class="hier-level">
      <div class="hier-box primitive">Primitive</div>
      <div class="hier-label">Raw values</div>
    </div>
    <div class="hier-arrow">&rarr;</div>
    <div class="hier-level">
      <div class="hier-box global">Global</div>
      <div class="hier-label">Semantic roles</div>
    </div>
    <div class="hier-arrow">&rarr;</div>
    <div class="hier-level">
      <div class="hier-box component">Component</div>
      <div class="hier-label">Usage context</div>
    </div>
  </div>

  <div class="hier-example">
    <div class="hier-ex-step">
      <div class="hier-ex-label">Primitive</div>
      <div class="hier-ex-value">
        <div class="hier-ex-dot" style="background:#006299"></div>
        blue500 &mdash; #006299
      </div>
    </div>
    <div class="hier-ex-arrow">&rarr;</div>
    <div class="hier-ex-step">
      <div class="hier-ex-label">Global (Dark Mode)</div>
      <div class="hier-ex-value">
        <div class="hier-ex-dot" style="background:#006299"></div>
        brand/primary-colors/regular
      </div>
    </div>
    <div class="hier-ex-arrow">&rarr;</div>
    <div class="hier-ex-step">
      <div class="hier-ex-label">Component</div>
      <div class="hier-ex-value">
        <div class="hier-ex-dot" style="background:#006299"></div>
        card/pricing/standard/action-button
      </div>
    </div>
  </div>
</section>

<!-- SECTION 12: GRID SYSTEM & LAYOUT -->
<section class="section" id="s12">
  <div class="section-header">
    <span class="section-num">12</span>
    <h2 class="section-title">Grid System &amp; Layout</h2>
  </div>

  <!-- MAX WIDTH WRAPPER DEMO -->
  <div style="margin-bottom:48px">
    <div class="palette-group-label" style="margin-bottom:16px">Content Wrapper — Max Width 1920px</div>
    <p style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text-subtle);margin-bottom:20px;line-height:22px;max-width:680px">
      All readable content sits inside a centered wrapper capped at <strong style="color:var(--text)">1536px</strong> — Tailwind's default <code style="font-family:var(--mono);color:var(--accent)">max-w-screen-2xl</code>. No custom config needed. Beyond that width, content stops scaling. Full-bleed elements (hero backgrounds, videos) still span the full viewport.
    </p>

    <!-- Visual wrapper demo -->
    <div style="background:rgba(34,210,230,0.04);border:1px solid var(--border);border-radius:12px;padding:24px;overflow:hidden;position:relative">
      <!-- Full bleed indicator -->
      <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(34,210,230,0.04) 0px,rgba(34,210,230,0.04) 1px,transparent 1px,transparent 40px);pointer-events:none"></div>
      <div style="font-family:'Bebas Neue',sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--text-subtle);margin-bottom:12px">← Full viewport width (full-bleed zone) →</div>
      <!-- Wrapper box -->
      <div style="background:rgba(34,210,230,0.08);border:2px dashed rgba(34,210,230,0.4);border-radius:8px;padding:16px 24px;margin:0 auto;max-width:100%">
        <div style="font-family:'Bebas Neue',sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);margin-bottom:8px">Content wrapper — max-width: 1536px (Tailwind 2xl default)</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <div style="flex:1;min-width:80px;background:rgba(34,210,230,0.15);border-radius:4px;height:40px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:10px;color:var(--accent)">col</div>
          <div style="flex:1;min-width:80px;background:rgba(34,210,230,0.15);border-radius:4px;height:40px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:10px;color:var(--accent)">col</div>
          <div style="flex:1;min-width:80px;background:rgba(34,210,230,0.15);border-radius:4px;height:40px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:10px;color:var(--accent)">col</div>
          <div style="flex:1;min-width:80px;background:rgba(34,210,230,0.15);border-radius:4px;height:40px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:10px;color:var(--accent)">col</div>
        </div>
      </div>
    </div>
  </div>

  <!-- BREAKPOINTS TABLE -->
  <div style="margin-bottom:48px">
    <div class="palette-group-label" style="margin-bottom:16px">Breakpoints (Tailwind-aligned)</div>
    <table class="a11y-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Token</th>
          <th>Min Width</th>
          <th>Tailwind Prefix</th>
          <th>Columns</th>
          <th>Gutter</th>
          <th>Wrapper Padding</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span style="font-family:'Bebas Neue',sans-serif;letter-spacing:2px;font-size:14px">Mobile</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">bp.mobile</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">0px</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--text-subtle)">(default)</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">4</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">16px</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">16px</span></td>
        </tr>
        <tr>
          <td><span style="font-family:'Bebas Neue',sans-serif;letter-spacing:2px;font-size:14px">Tablet</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">bp.tablet</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">768px</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">md:</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">8</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">16px</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">24px</span></td>
        </tr>
        <tr>
          <td><span style="font-family:'Bebas Neue',sans-serif;letter-spacing:2px;font-size:14px">Desktop</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">bp.desktop</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">1280px</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">xl:</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">12</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">24px</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">48px</span></td>
        </tr>
        <tr>
          <td><span style="font-family:'Bebas Neue',sans-serif;letter-spacing:2px;font-size:14px">Wide</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">bp.wide</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">1536px</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">2xl:</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">12</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">24px</span></td>
          <td><span style="font-family:var(--mono);font-size:12px">48px (frozen at 1536px)</span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- FULL-BLEED VS CONTAINED -->
  <div style="margin-bottom:48px">
    <div class="palette-group-label" style="margin-bottom:16px">Full-Bleed vs Contained</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">

      <!-- Full bleed example -->
      <div style="border-radius:12px;overflow:hidden;border:1px solid var(--border)">
        <div style="background:linear-gradient(135deg,#006299,#00141E);padding:0;position:relative;height:120px;display:flex;align-items:center;justify-content:center">
          <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 32px)"></div>
          <span style="font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:3px;color:rgba(237,252,255,0.5);text-transform:uppercase;position:relative">← Full-bleed background →</span>
        </div>
        <div style="background:var(--bg-surface);padding:16px">
          <div style="font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);margin-bottom:6px">Full-Bleed</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:12px;color:var(--text-subtle);line-height:18px">Hero backgrounds, section backgrounds, full-width videos. Use <code style="font-family:var(--mono);color:var(--accent)">w-full</code> with no max-width.</div>
        </div>
      </div>

      <!-- Contained example -->
      <div style="border-radius:12px;overflow:hidden;border:1px solid var(--border)">
        <div style="background:linear-gradient(135deg,#006299,#00141E);padding:0;position:relative;height:120px;display:flex;align-items:center;justify-content:center">
          <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 32px)"></div>
          <div style="position:relative;background:rgba(34,210,230,0.15);border:2px dashed rgba(34,210,230,0.5);border-radius:6px;padding:12px 32px">
            <span style="font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:3px;color:#22D2E6;text-transform:uppercase">Content wrapper</span>
          </div>
        </div>
        <div style="background:var(--bg-surface);padding:16px">
          <div style="font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);margin-bottom:6px">Contained</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:12px;color:var(--text-subtle);line-height:18px">Text, cards, navigation content. Always inside <code style="font-family:var(--mono);color:var(--accent)">max-w-content mx-auto px-4 md:px-6 xl:px-12</code>.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ASPECT RATIOS -->
  <div>
    <div class="palette-group-label" style="margin-bottom:16px">Media Aspect Ratios</div>
    <p style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text-subtle);margin-bottom:24px;line-height:22px;max-width:680px">
      All video and image containers must declare an aspect ratio token. This prevents layout shift and ensures the correct source resolution is requested from the CDN.
    </p>

    <div style="display:flex;flex-wrap:wrap;gap:20px;margin-bottom:32px">

      <!-- 16:9 Hero -->
      <div style="flex:1;min-width:200px">
        <div style="aspect-ratio:16/9;background:linear-gradient(135deg,#002952,#006299);border-radius:8px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden">
          <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 20px),repeating-linear-gradient(0deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 20px)"></div>
          <span style="font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:3px;color:rgba(237,252,255,0.6)">16 : 9</span>
        </div>
        <div style="margin-top:10px">
          <div style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.hero</div>
          <div style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.player</div>
          <div style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.thumbnail</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:11px;color:var(--text-subtle);margin-top:4px">Min: 1920×1080px</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:11px;color:var(--text-subtle)">Broadcast standard — use for all video</div>
        </div>
      </div>

      <!-- 21:9 Cinematic -->
      <div style="flex:1;min-width:200px">
        <div style="aspect-ratio:21/9;background:linear-gradient(135deg,#00141E,#002F60);border-radius:8px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden">
          <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 20px),repeating-linear-gradient(0deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 20px)"></div>
          <span style="font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:3px;color:rgba(237,252,255,0.6)">21 : 9</span>
        </div>
        <div style="margin-top:10px">
          <div style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.hero-wide</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:11px;color:var(--text-subtle);margin-top:4px">Min: 1920×823px</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:11px;color:var(--text-subtle)">Cinematic hero on wide screens</div>
        </div>
      </div>

      <!-- 3:2 Editorial -->
      <div style="flex:1;min-width:160px">
        <div style="aspect-ratio:3/2;background:linear-gradient(135deg,#002952,#0B89B5);border-radius:8px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden">
          <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 20px),repeating-linear-gradient(0deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 20px)"></div>
          <span style="font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:3px;color:rgba(237,252,255,0.6)">3 : 2</span>
        </div>
        <div style="margin-top:10px">
          <div style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.editorial</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:11px;color:var(--text-subtle);margin-top:4px">Min: 1200×800px</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:11px;color:var(--text-subtle)">Article / editorial header</div>
        </div>
      </div>

      <!-- 1:1 Square -->
      <div style="flex:0 0 auto;width:160px">
        <div style="aspect-ratio:1/1;background:linear-gradient(135deg,#00487C,#22D2E6);border-radius:8px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden">
          <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 20px),repeating-linear-gradient(0deg,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 20px)"></div>
          <span style="font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:3px;color:rgba(237,252,255,0.6)">1 : 1</span>
        </div>
        <div style="margin-top:10px">
          <div style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.thumbnail-square</div>
          <div style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.split-screen</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:11px;color:var(--text-subtle);margin-top:4px">Min: 480×480px</div>
          <div style="font-family:'Titillium Web',sans-serif;font-size:11px;color:var(--text-subtle)">Avatar, badge, split-screen video</div>
        </div>
      </div>
    </div>

    <!-- Aspect ratio token table -->
    <table class="a11y-table">
      <thead>
        <tr>
          <th>Token</th>
          <th>Ratio</th>
          <th>Min Source Resolution</th>
          <th>Tailwind Class</th>
          <th>Use Case</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.hero</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">16:9</span></td>
          <td><span style="font-family:var(--mono);font-size:11px">1536 × 864px (at max-width)</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">aspect-video</span></td>
          <td style="font-family:'Titillium Web',sans-serif;font-size:12px">Full-bleed hero video/image</td>
        </tr>
        <tr>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.hero-wide</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">21:9</span></td>
          <td><span style="font-family:var(--mono);font-size:11px">1536 × 659px (at max-width)</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">aspect-[21/9]</span></td>
          <td style="font-family:'Titillium Web',sans-serif;font-size:12px">Cinematic hero on wide screens</td>
        </tr>
        <tr>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.player</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">16:9</span></td>
          <td><span style="font-family:var(--mono);font-size:11px">1920 × 1080px (HD)</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">aspect-video</span></td>
          <td style="font-family:'Titillium Web',sans-serif;font-size:12px">Inline video player — always 16:9</td>
        </tr>
        <tr>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.thumbnail</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">16:9</span></td>
          <td><span style="font-family:var(--mono);font-size:11px">960 × 540px</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">aspect-video</span></td>
          <td style="font-family:'Titillium Web',sans-serif;font-size:12px">Event/match card thumbnails</td>
        </tr>
        <tr>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.thumbnail-square</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">1:1</span></td>
          <td><span style="font-family:var(--mono);font-size:11px">480 × 480px</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">aspect-square</span></td>
          <td style="font-family:'Titillium Web',sans-serif;font-size:12px">Sport icon, avatar, team badge</td>
        </tr>
        <tr>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.editorial</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">3:2</span></td>
          <td><span style="font-family:var(--mono);font-size:11px">1200 × 800px</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">aspect-[3/2]</span></td>
          <td style="font-family:'Titillium Web',sans-serif;font-size:12px">Editorial / article header image</td>
        </tr>
        <tr>
          <td><span style="font-family:var(--mono);font-size:11px;color:var(--accent)">media.ratio.split-screen</span></td>
          <td><span style="font-family:var(--mono);font-size:12px;font-weight:700">1:1 / 50svw×100svh</span></td>
          <td><span style="font-family:var(--mono);font-size:11px">960 × 960px</span></td>
          <td><span style="font-family:var(--mono);font-size:11px;color:#22D2E6">w-[50svw] h-screen</span></td>
          <td style="font-family:'Titillium Web',sans-serif;font-size:12px">50/50 split layout (current hero pattern)</td>
        </tr>
      </tbody>
    </table>
  </div>

</section>

</div><!-- /content -->
    </div><!-- /panel-main (foundations) -->
  </div><!-- /panel-shell (foundations) -->
</div><!-- /#foundationsPanel -->

