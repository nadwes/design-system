        <a href="#core-badges"><span class="nav-num">06</span> Badges</a>
      </nav>
    </aside>
    <!-- Core Components main content -->
    <div class="panel-main">
      <div class="panel-content">

        <div style="margin-bottom:40px">
          <h2 class="section-title">Core Components</h2>
          <p style="font-family:'Titillium Web',sans-serif;font-size:14px;color:var(--text-subtle);line-height:22px;max-width:640px">
            Atomic UI elements — the smallest building blocks of the design system. Each component is self-contained, token-driven, and has no dependencies on other components.
          </p>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px">

          <div id="core-buttons" style="background:rgba(0,41,82,0.35);border:1px dashed rgba(34,210,230,0.2);border-radius:10px;padding:24px 20px">
            <div style="font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px;color:#22D2E6;margin-bottom:6px">Button</div>
            <div style="font-size:12px;color:var(--text-subtle);line-height:18px">Primary, secondary, ghost, destructive. All sizes and states.</div>
            <div style="margin-top:12px;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(34,210,230,0.4)">Coming soon</div>
          </div>

          <div id="core-inputs" style="background:rgba(0,41,82,0.35);border:1px dashed rgba(34,210,230,0.2);border-radius:10px;padding:24px 20px">
            <div style="font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px;color:#22D2E6;margin-bottom:6px">Input</div>
            <div style="font-size:12px;color:var(--text-subtle);line-height:18px">Text, number, search. Default, focus, error, disabled states.</div>
            <div style="margin-top:12px;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(34,210,230,0.4)">Coming soon</div>
          </div>

          <div id="core-checkboxes" style="background:rgba(0,41,82,0.35);border:1px dashed rgba(34,210,230,0.2);border-radius:10px;padding:24px 20px">
            <div style="font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px;color:#22D2E6;margin-bottom:6px">Checkbox</div>
            <div style="font-size:12px;color:var(--text-subtle);line-height:18px">Unchecked, checked, indeterminate, disabled.</div>
            <div style="margin-top:12px;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(34,210,230,0.4)">Coming soon</div>
          </div>

          <div id="core-radios" style="background:rgba(0,41,82,0.35);border:1px dashed rgba(34,210,230,0.2);border-radius:10px;padding:24px 20px">
            <div style="font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px;color:#22D2E6;margin-bottom:6px">Radio</div>
            <div style="font-size:12px;color:var(--text-subtle);line-height:18px">Single selection within a group. All states.</div>
            <div style="margin-top:12px;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(34,210,230,0.4)">Coming soon</div>
          </div>

          <div id="core-toggles" style="background:rgba(0,41,82,0.35);border:1px dashed rgba(34,210,230,0.2);border-radius:10px;padding:24px 20px">
            <div style="font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px;color:#22D2E6;margin-bottom:6px">Toggle</div>
            <div style="font-size:12px;color:var(--text-subtle);line-height:18px">On/off switch. With and without label.</div>
            <div style="margin-top:12px;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(34,210,230,0.4)">Coming soon</div>
          </div>

          <div id="core-badges" style="background:rgba(0,41,82,0.35);border:1px dashed rgba(34,210,230,0.2);border-radius:10px;padding:24px 20px">
            <div style="font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px;color:#22D2E6;margin-bottom:6px">Badge</div>
            <div style="font-size:12px;color:var(--text-subtle);line-height:18px">Status, label, count. All semantic color variants.</div>
            <div style="margin-top:12px;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(34,210,230,0.4)">Coming soon</div>
          </div>

        </div>
      </div>
    </div><!-- /panel-main (core) -->
  </div><!-- /panel-shell (core) -->
</div><!-- /#coreComponentsPanel -->

<!-- ═══════════════════════════════════════════════════════════════════
     TAB PANEL: COMPOSITE COMPONENTS
════════════════════════════════════════════════════════════════════ -->
<div class="tab-panel" id="compositeComponentsPanel" data-panel="composite">
  <div class="panel-shell">
    <!-- Composite Components sidebar -->
    <aside class="sidebar" id="sidebarComposite">
      <nav>
